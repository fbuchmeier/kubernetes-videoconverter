{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "HEAD",
  "release-type": "simple",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "videoconverter",
      "include-component-in-tag": false,
      "extra-files": [
        "pyproject.toml",
        "helm/videoconverter/Chart.yaml"
      ]
